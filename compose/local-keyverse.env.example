KEYVERSE_ISSUER=https://identity.example/realms/lineageweave-demo
LINEAGEWEAVE_OIDC_CLIENT_ID=lineageweave-web
LINEAGEWEAVE_OIDC_CLIENT_SECRET=
LINEAGEWEAVE_PUBLIC_ORIGIN=https://localhost:18082
LINEAGEWEAVE_OIDC_REDIRECT_URI={origin}/api/oidc/callback
# Externally operated Keyverse only. Compose never runs an IdP service:
LINEAGEWEAVE_DEV_MODE=0
LINEAGEWEAVE_COOKIE_SECURE=1

{
  "realm": "lw-e2e",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {"name": "reader", "description": "Test-only LineageWeave reader"}
    ]
  },
  "clients": [
    {
      "clientId": "lineageweave-web",
      "name": "LineageWeave test relying party",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${LINEAGEWEAVE_E2E_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${LINEAGEWEAVE_E2E_REDIRECT_URI}"],
      "webOrigins": ["${LINEAGEWEAVE_E2E_WEB_ORIGIN}"],
      "protocolMappers": [
        {
          "name": "lw-e2e-org",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org",
            "claim.name": "org",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "lw-e2e-workspace",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "workspace",
            "claim.name": "workspace",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "lw-e2e-role",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "lineageweave-browser-e2e@example.test",
      "email": "lineageweave-browser-e2e@example.test",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Lineage",
      "lastName": "Test",
      "attributes": {
        "org": ["${LINEAGEWEAVE_E2E_ORG}"],
        "workspace": ["${LINEAGEWEAVE_E2E_WORKSPACE}"]
      },
      "realmRoles": ["reader"],
      "credentials": [
        {
          "type": "password",
          "value": "${LINEAGEWEAVE_E2E_TEST_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
